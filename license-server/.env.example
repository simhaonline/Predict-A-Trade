# ==== Predict-A-Trade license server configuration ====
# Copy to .env and fill in. NEVER commit the real .env.

# HTTP listen port (behind nginx/Caddy TLS termination, or load balancer)
PORT=8080

# PostgreSQL DSN (required)
DATABASE_URL=postgres://pat_license:CHANGE_ME@postgres:5432/pat_license?sslmode=disable

# Redis DSN
REDIS_URL=redis://redis:6379

# "production" rejects plain HTTP; "development" allows local testing
APP_ENV=production

# Stripe: secret key for API calls, signing secret for /v1/webhook/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cache TTLs (seconds)
HEARTBEAT_CACHE_TTL=60
ACTIVATION_CACHE_TTL=3600

# Rate limits (requests per minute)
RATE_LIMIT_IP_PER_MIN=10
RATE_LIMIT_KEY_PER_MIN=30